# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Server-only Supabase value for admin/session APIs
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Separate admin login credentials for /admin-login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-in-production
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Keep false until SMTP/email recovery is intentionally enabled
NEXT_PUBLIC_ENABLE_EMAIL_RECOVERY=false
